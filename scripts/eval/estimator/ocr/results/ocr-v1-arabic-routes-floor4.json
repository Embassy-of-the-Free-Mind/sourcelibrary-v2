{
 "bars": {
  "_about": "The quality bar a route must clear in a cell, read by route_ocr_v1.py (#6740, .claude/docs/quality-research-system.md \u00a73a). A route clears the bar on a posterior draw when its expected error is within the margin of the measured, enabled route with the lowest posterior mean error (that route's draw, so the comparison is paired) (and under `absolute_max` if one is set). A margin rather than an absolute number, because levels differ by script and reference set far more than readers' tolerance does: the bar is 'a reader would not notice the difference from the best route we can run'. Prose cells need the character bar; number-dense cells need both.",
  "threshold": 0.9,
  "character": {
   "metric": "E[CER] among reads, the 100%-error point mass included",
   "margin": 0.01,
   "absolute_max": null,
   "margin_relative": 0.15
  },
  "numbers": {
   "metric": "misread + dropped + spurious numbers per number printed",
   "margin": 0.02,
   "absolute_max": null,
   "margin_relative": 0.15
  },
  "_margins_note": "The margin is max(margin, margin_relative x the best route's error): 0.01 CER is about one wrong character per line of 100, and on a chart whose best route is at 10% CER a reader cannot tell 10% from 11%, so there the margin is 15% of the best. 0.02 per number is one more wrong number in fifty. Both are judgment calls, set here so they can be changed without code; the router prints how the choice moves at half and double the margins."
 },
 "gpu_state": "idle",
 "units": [
  "usd",
  "agy_plan_share",
  "claude_weekly_points"
 ],
 "quota_shares": {
  "agy_share_per_call": 4.3632e-06,
  "agy_derivation": "meter_quota_share.py over /root/agy-quota/calls.csv, 2026-10-13T07:01 to 2026-10-24T05:30 (10.94 days): 83,551 calls succeeded and 1,936 hit the cap (so the stretch used the whole allowance) = 229,190 calls per 30 days. Cross-check: median 1,578 calls in the 5 h before a 429 burst = 227,232 per 30 days. Every agy model is counted as one call of one pool, as the meter counts them. A second reading, the median calls in the 24 h before a lock (status.json past_bursts prev24h: 5,771), gives 173K per 30 days: the share is between 4.4e-6 and 5.8e-6 a call.",
  "claude_points_per_call": 0.0303,
  "claude_derivation": "One point = 1% of an account's weekly limit. 66 sealed claude -p Sonnet text calls (about 15K in / 5K out) = +2 weekly points on one account (2026-10-14, #6721). NOT an OCR reading: an image call has not been metered. Re-measure before a Claude route decides a cell.",
  "unused_quota_value": 1.0,
  "unused_quota_note": "1.0 = a call is worth its full share. Quota left unused at a reset is worth nothing, so near a reset with quota to spare this falls toward 0 (set it per run)."
 },
