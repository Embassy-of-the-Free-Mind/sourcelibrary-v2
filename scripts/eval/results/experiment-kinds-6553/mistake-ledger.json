{
 "classes": [
  {
   "name": "harness-bug-corrupted-result",
   "definition": "A code, parser or harness bug made a result or arm label wrong, or shipped a wrong output, and it had to be fixed and re-run.",
   "preventer": "Harness self-check that fails loudly when an arm substitutes nothing, plus a golden-fixture test that each arm's inputs differ before any judge packet is built."
  },
  {
   "name": "wrong-reference-ground-truth",
   "definition": "The reference, label or comparison source (TCP, catalogue, Wikisource, stored revision) was itself wrong, so scores or conclusions were wrong.",
   "preventer": "By-eye audit of a random 50-item sample of the reference before scoring, and report the reference error rate beside every score."
  },
  {
   "name": "overclaimed-headline-claim",
   "definition": "A headline claim was reported from in-sample, first-pass or interim data and later retracted, shrunk or failed to replicate.",
   "preventer": "Preregistered rule with a held-out draw; no number leaves the worktree without a held-out or replicate check."
  },
  {
   "name": "unmeasured-or-wrong-denominator-claim",
   "definition": "A number was asserted without measurement, or measured against the wrong population or denominator, and was later corrected.",
   "preventer": "Script that prints numerator, denominator and population definition with every figure; spot-check against production rows before asserting."
  },
  {
   "name": "blind-or-wrong-instrument",
   "definition": "The detector, screen, label or probe could not see the thing measured, or measured the wrong element, so findings were false or missing.",
   "preventer": "Planted-positive and negative control set run through every instrument before use, plus a by-eye check of about 40 flagged items."
  },
  {
   "name": "judge-bias-or-confound",
   "definition": "Judge bias (same-family or self-preference, invented defects) or a confound (cross-round, engine and version, bad OCR) distorted the comparison.",
   "preventer": "Cross-family judge, a wrong-page control arm in every packet, and same-round arms."
  },
  {
   "name": "stale-or-wrong-premise",
   "definition": "A starting assumption or earlier conclusion was out of date or false, so the question or recommendation had to be replaced.",
   "preventer": "Premise check in the prereg: re-measure the baseline against current production before designing the arms."
  },
  {
   "name": "stratum-conflation",
   "definition": "Different populations (manuscript and print, ages, scripts) were pooled and the pooled effect was misread.",
   "preventer": "Form and script labelled by eye from the image and stratified in the design before analysis."
  },
  {
   "name": "pairing-identity-error",
   "definition": "Image, text, ID or entity was paired with the wrong counterpart (offset, wrong QID, wrong field, wrong page).",
   "preventer": "Pairing-sanity check comparing image against text on a sample, plus live identity verification (P31/P50/VIAF) before writes."
  },
  {
   "name": "env-config-failure",
   "definition": "Environment, PATH, auth, bundling or checkout configuration caused a failure or false refusal that needed a re-run.",
   "preventer": "Preflight script in the job wrapper that verifies PATH, binaries and checkout, with /root/.local/bin added to claude-job.sh."
  },
  {
   "name": "leakage-contamination",
   "definition": "Test material leaked into the prompt, design or ids, so the measure was contaminated.",
   "preventer": "Leakage guard that diffs prompt examples against the eval set and uses opaque ids; refuse to run on violation."
  },
  {
   "name": "no-noise-floor-design-flaw",
   "definition": "The design had an unreachable bound or lacked a same-arm rerun noise floor.",
   "preventer": "Noise floor = same-arm rerun before comparing arms; a power check that the preregistered bound is reachable."
  },
  {
   "name": "untested-on-real-data",
   "definition": "Logic passed synthetic tests but was wrong on real, dirty production data.",
   "preventer": "Hand spot-check of about 7 production items before trusting a derivation or unit test."
  }
 ],
