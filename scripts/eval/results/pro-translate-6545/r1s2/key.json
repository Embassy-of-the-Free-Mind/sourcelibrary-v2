   },
   "plant": {
    "kind": "name",
    "old": "I would lead you, I would bring you into my mother's house,",
    "new": "You would lead you, I would bring you into my mother's house,",
    "how": "\\bI ((?:have|had|said|say|declare|explain|ask|teach|will|shall|did|can|must|should|would|know|see|state|maintain|hold|accept|assert|claim|think))\\b → you $1"
