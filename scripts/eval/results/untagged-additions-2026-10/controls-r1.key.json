 "positives": [
  {
   "id": "pos:6a22d6e168f6a1498e2ffe6a_00160",
   "lang": "German",
   "kind": "explanation",
   "sentence": "Here the author is alluding to require, a commonplace of the period.",
   "n": 3,
   "form": "bare"
  },
  {
   "id": "pos:69906485ef12272ffdc93acc_00116",
   "lang": "French",
   "kind": "image_description",
   "sentence": "A woodcut at the head of the page shows two figures standing beside a furnace.",
   "n": 16,
   "form": "bare"
  },
  {
   "id": "pos:6954347b1479a63c11089b35_00091",
   "lang": "German",
   "kind": "definition",
   "sentence": "provide: a term used for the first stage of the work.",
   "n": 13,
   "form": "bare"
  },
  {
   "id": "pos:1a8485e5-5331-41df-bfc1-6efd65238f55_00581",
   "lang": "Latin",
   "kind": "summary",
   "sentence": "This page continues the discussion begun in the previous chapter.",
   "n": 20,
   "form": "bare"
  },
  {
   "id": "pos:695262d8ab34727b1f046ade_00167",
   "lang": "Latin",
   "kind": "explanation",
   "sentence": "This refers to Lunar, which readers of the time would have recognised at once.",
   "n": 5,
   "form": "bare"
  },
  {
   "id": "pos:69ade6cc2fcf4ffa86cec233_00093",
   "lang": "German",
   "kind": "image_description",
   "sentence": "[Illustration: an ornamental initial letter decorated with vines and a small bird.]",
   "n": 4,
   "form": "bracketed"
  },
  {
   "id": "pos:695594f97bd6d2cd1d61e685_00331",
   "lang": "Latin",
   "kind": "definition",
   "sentence": "[Hebron: literally, 'that which is hidden']",
   "n": 7,
   "form": "bracketed"
  },
  {
   "id": "pos:6a06d39b9a48d5139996355a_00151",
   "lang": "Italian",
   "kind": "summary",
   "sentence": "In summary, the author argues that experience must be preferred to authority.",
   "n": 9,
   "form": "bare"
  },
  {
   "id": "pos:6a09ff43fa20006dbaba8d78_00193",
   "lang": "Pali",
   "kind": "explanation",
   "sentence": "The point of the comparison is that Section stands for the whole of the argument.",
   "n": 20,
   "form": "bare"
  },
  {
   "id": "pos:69908ac1c0656c0b3bcc0813_00050",
   "lang": "Arabic",
   "kind": "image_description",
   "sentence": "The page is decorated with a printer's device depicting an anchor and a dolphin.",
   "n": 18,
   "form": "bare"
  },
  {
   "id": "pos:69b18a89c4be2cdd0edc810d_00135",
   "lang": "Latin",
   "kind": "definition",
   "sentence": "beginning here means the inner or spiritual sense, as opposed to the letter.",
   "n": 5,
   "form": "bare"
  },
  {
   "id": "pos:69b51dcc47b06ecd58184b91_00073",
   "lang": "German",
   "kind": "summary",
   "sentence": "The author now turns from theory to practical instruction.",
   "n": 12,
   "form": "bare"
  },
  {
   "id": "pos:69b6fb4a3c7947b468d7aa52_00309",
   "lang": "Latin",
   "kind": "explanation",
   "sentence": "By this the writer means that the practice had already fallen out of use.",
   "n": 4,
   "form": "bare"
  },
  {
   "id": "pos:69920bff01d3dcea63458842_00389",
   "lang": "Greek",
   "kind": "image_description",
   "sentence": "Below the text is an engraving of a seated scholar holding an open book.",
   "n": 14,
   "form": "bare"
  },
  {
   "id": "pos:69de989b1b234a773e438e19_00234",
   "lang": "Italian",
   "kind": "definition",
   "sentence": "(importance is an old measure equal to about half a litre.)",
   "n": 10,
   "form": "bracketed"
  },
  {
   "id": "pos:6953e58d77f38f6761bf0cfc_00123",
   "lang": "French",
   "kind": "summary",
   "sentence": "The following section lists the remaining items in the same manner.",
   "n": 12,
   "form": "bare"
  },
  {
   "id": "pos:69905e262fd6a039938a154f_00067",
   "lang": "Latin",
   "kind": "explanation",
   "sentence": "Pentagons was a well-known authority in the schools of the time.",
   "n": 2,
   "form": "bare"
  },
  {
   "id": "pos:69a6827ed5bf106c72bb8d6f_00286",
   "lang": "French",
   "kind": "image_description",
   "sentence": "A decorative border of flowers and scrollwork surrounds the text.",
   "n": 4,
   "form": "bare"
  },
  {
   "id": "pos:69520588ab34727b1f042d0c_00165",
   "lang": "Italian",
   "kind": "definition",
   "sentence": "The word translated here as 'virtue' means power or efficacy rather than moral goodness.",
   "n": 6,
   "form": "bare"
  },
  {
   "id": "pos:6952603cab34727b1f04647b_00194",
   "lang": "German",
   "kind": "summary",
   "sentence": "The rest of the page repeats the same argument with further examples.",
   "n": 3,
   "form": "bare"
  },
  {
   "id": "pos:69d5ad004dc55b8478dde8b5_01455",
   "lang": "Hebrew",
   "kind": "explanation",
   "sentence": "This is a reference to the doctrine discussed in the earlier chapters of the work.",
   "n": 57,
   "form": "bare"
  },
  {
   "id": "pos:69935b692c63944063133f67_00112",
   "lang": "Chinese",
   "kind": "image_description",
   "sentence": "In the margin a small hand-drawn pointing finger marks this passage.",
   "n": 33,
   "form": "bare"
  },
  {
   "id": "pos:69a5d924a63a00aaae8aae3b_00105",
   "lang": "Dutch",
   "kind": "definition",
   "sentence": "Swammerdam, that is, the common name for quicksilver among the older writers.",
   "n": 5,
   "form": "bare"
  },
  {
   "id": "pos:69b99e681f30176bf4d3798a_00155",
   "lang": "Pali",
   "kind": "summary",
   "sentence": "Having set out the objections, the text proceeds to answer each in turn.",
   "n": 13,
   "form": "bare"
  },
  {
   "id": "pos:69ade7946a6b945bbdfa2d0a_00091",
   "lang": "German",
   "kind": "explanation",
   "sentence": "The passage echoes a saying usually attributed to Aristotle.",
   "n": 7,
   "form": "bare"
  },
  {
   "id": "pos:69557433f63a75710917330c_00146",
   "lang": "Greek",
   "kind": "definition",
   "sentence": "[i.e., the philosophers' stone]",
   "n": 7,
   "form": "bracketed"
  },
  {
   "id": "pos:8a9eea4b-6be1-4424-9a38-b7a0deb58f95_00256",
   "lang": "Latin",
   "kind": "summary",
   "sentence": "The passage concludes by restating the main point of the chapter.",
   "n": 47,
   "form": "bare"
  },
  {
   "id": "pos:69a6849d7ab725b59be41319_00173",
   "lang": "Italian",
   "kind": "explanation",
   "sentence": "In other words, the reader is being warned not to take the statement literally.",
   "n": 13,
   "form": "bare"
  },
  {
   "id": "pos:69ac7ee520878c5c9ba51e75_00098",
   "lang": "Latin",
   "kind": "definition",
   "sentence": "By Demonstration is meant a kind of salt obtained by burning plants.",
   "n": 13,
   "form": "bare"
  },
  {
   "id": "pos:69b185e9c4be2cdd0edc464c_00489",
   "lang": "Dutch",
   "kind": "summary",
   "sentence": "What follows is a list of the authorities cited in support of this view.",
   "n": 7,
   "form": "bare"
  },
  {
   "id": "pos:6991eac02f801130a473e424_00074",
   "lang": "Italian",
   "kind": "explanation",
   "sentence": "The allusion is to a story told by Pliny in his Natural History.",
   "n": 7,
   "form": "bare"
  },
  {
   "id": "pos:69593274b91a6184ea943873_00315",
   "lang": "French",
   "kind": "image_description",
   "sentence": "(The page has a large ornamental tailpiece showing a vase of fruit.)",
   "n": 6,
   "form": "bracketed"
  },
  {
   "id": "pos:6a2198371994d1df1e5e0235_00118",
   "lang": "Arabic",
   "kind": "definition",
   "sentence": "The term Jewish denotes a vessel with a long neck used for distillation.",
   "n": 13,
   "form": "bare"
  },
  {
   "id": "pos:69e7518010ee9075bcdcdaf0_00223",
   "lang": "Spanish",
   "kind": "summary",
   "sentence": "To summarise: the three causes named above are treated as one.",
   "n": 5,
   "form": "bare"
  },
  {
   "id": "pos:69aebfa4c337b1e6a4d582f3_00161",
   "lang": "Italian",
   "kind": "explanation",
   "sentence": "This reflects the common belief of the age that such things were governed by the stars.",
   "n": 11,
   "form": "bare"
  },
  {
   "id": "pos:69593291b91a6184ea943bbe_00122",
   "lang": "French",
   "kind": "image_description",
   "sentence": "The text is laid out in two columns separated by a vertical rule.",
   "n": 16,
   "form": "bare"
  },
  {
   "id": "pos:6976f5fb7b4366f057e0e974_00631",
   "lang": "Latin",
   "kind": "definition",
   "sentence": "(Hellebore: an honorific title given to a learned teacher.)",
   "n": 11,
   "form": "bracketed"
  },
  {
   "id": "pos:69b4d643853c26e0d15603c8_00136",
   "lang": "Latin",
   "kind": "summary",
   "sentence": "The text breaks off here and resumes on the following page.",
   "n": 6,
   "form": "bare"
  }
 ],
