# Withhold stale translations (#4523). Every apply pass of the re-OCR lane puts
# more pages into the state where the English on the page was made from a
# transcription we have since replaced — so the takedown has to be a STANDING
# sweep over a re-derived predicate, not a one-off over a frozen id list. Runs
# 20 minutes after the half-hourly re-OCR relaunch, so an apply pass and its
# cleanup do not race; the sweep is idempotent and resumable, so a missed run
# costs nothing but latency. The `[ -f ]` guard makes it a no-op until the
# auto-pull brings the scripts.
20 * * * * cd /root/sourcelibrary && [ -f scripts/maintenance/withhold-stale-translations.mjs ] && flock -n /tmp/sl-withhold-stale-tr.lock bash -c "set -a; source .env.production.local; set +a; node scripts/maintenance/withhold-stale-translations.mjs --apply" >> /var/log/sourcelibrary/withhold-stale-translations.log 2>&1
# …and the reconciliation the sweep cannot do for itself: LEAKED / ORPHANED /
# UNBACKED, plus the Supabase side. Exit 2 means UNKNOWN, which is not PASS.
50 7 * * * cd /root/sourcelibrary && [ -f scripts/audit/withheld-translation-drift.mjs ] && flock -n /tmp/sl-withhold-drift.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/withheld-translation-drift.mjs" >> /var/log/sourcelibrary/withhold-stale-translations.log 2>&1
# Daily meter-gap detector (#4599, PR #4821): billed realtime output tokens vs our
# usage rows over the trailing 7 days; exit 3 + one email/day above 10%. Gated on the
# read-only service-account key so the line is inert wherever the key is absent.
30 8 * * * cd /root/sourcelibrary && [ -f /root/.gcp/spend-reconcile.json ] && flock -n /tmp/sl-spend-gap.lock bash -c "set -a; source .env.production.local; set +a; GOOGLE_SERVICE_ACCOUNT_JSON=/root/.gcp/spend-reconcile.json node scripts/audit/spend-reconcile.mjs --days=7 --check-gap --alert" >> /var/log/sourcelibrary/spend-gap.log 2>&1
# Paid-vs-got daily ledger (#5499): yesterday's Gemini spend by lane from COLLECTED usage rows
# against pages written (page provenance), open batches by age (FAIL past 40 h; Gemini expires
# them at 48 h), duplicate/repeat/paid-for-nothing waste, and on Mondays the invoice vs metered
# vs attributed. Read-only except one ops_reports row (paid-vs-got-<day>, shown on /admin/spend)
# and, on FAIL, one deduped GitHub issue. Exit 1 = FAIL, 2 = could not measure. No model call.
10 6 * * * cd /root/sourcelibrary && [ -f scripts/audit/paid-vs-got.mjs ] && flock -n /tmp/sl-paid-vs-got.lock bash -c "set -a; source .env.production.local; set +a; GOOGLE_SERVICE_ACCOUNT_JSON=/root/.gcp/spend-reconcile.json node scripts/audit/paid-vs-got.mjs --apply" >> /var/log/sourcelibrary/paid-vs-got.log 2>&1
# Daily spend check (#5743): ONE verdict over (a) paid-vs-got for yesterday, (b) machines the lease watchdog
# flags + RunPod pods past the deadline in their name, (c) budget envelopes (paid with no pages, near cap, stored
# spend), (d) the dial in force that day vs the invoice. Writes one ops_reports row (spend-daily-<day>), shown as the
# "spend check" line on /admin/work; emails only on FAIL (7-day cooldown per failure set). Exit 1 = FAIL, 2 = a
# source unreadable. No model call. Runs after paid-vs-got (06:10), whose row it reads.
0 7 * * * cd /root/sourcelibrary && [ -f scripts/audit/spend-daily.mjs ] && flock -n /tmp/sl-spend-daily.lock bash -c "set -a; source .env.production.local; set +a; GOOGLE_SERVICE_ACCOUNT_JSON=/root/.gcp/spend-reconcile.json node scripts/audit/spend-daily.mjs --apply" >> /var/log/sourcelibrary/spend-daily.log 2>&1
# Weekly spend cut list (#5743), Mondays 06:30: a headless claude job (subscription; no API spend) runs
# spend-daily.mjs --week and posts ONE comment on #5743, at most 5 numbered cuts with recommended defaults, which
# /admin/work lists under WAITING ON YOU. It never stops, deletes or changes anything. Brief: scripts/audit/spend-weekly-brief.md
30 6 * * 1 [ -f /root/sourcelibrary/scripts/audit/spend-weekly-brief.md ] && /root/bin/claude-job.sh start waste-review-weekly-$(date -u +\%Y\%m\%d) /root/sourcelibrary/scripts/audit/spend-weekly-brief.md >> /var/log/sourcelibrary/spend-weekly.log 2>&1
# /about/models page counts (#5601): which engine's text every page carries, from page provenance.
# A checkpointed walk over pages on a secondary (~1 h); writes one ops_reports row (model-usage).
# Exit 3 = an engine wrote pages in the last 30 days that the page does not describe. No model call.
40 3 * * 3 cd /root/sourcelibrary && [ -f scripts/audit/model-usage-snapshot.mjs ] && flock -n /tmp/sl-model-usage.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/model-usage-snapshot.mjs --apply" >> /var/log/sourcelibrary/model-usage.log 2>&1

# GPU lease watchdog (#4909): stops rented Scaleway GPUs whose lease-until tag has passed, via the
# provider API (a guest poweroff is "stopped in place" and still billed); nags on untagged running GPUs.
# The Scaleway key lives in /root/.scaleway.env and is sourced by these two lines only.
*/10 * * * * cd /root/sourcelibrary && [ -f scripts/maintenance/gpu-lease-watchdog.mjs ] && [ -f /root/.scaleway.env ] && flock -n /tmp/sl-gpu-lease.lock bash -c "set -a; source .env.production.local; source /root/.scaleway.env; set +a; node scripts/maintenance/gpu-lease-watchdog.mjs --apply" >> /var/log/sourcelibrary/gpu-lease-watchdog.log 2>&1
# Monday 08:10 — volumes that bill while their instance is stopped/archived, with approximate cost
10 8 * * 1 cd /root/sourcelibrary && [ -f scripts/maintenance/gpu-lease-watchdog.mjs ] && [ -f /root/.scaleway.env ] && flock -n /tmp/sl-gpu-lease.lock bash -c "set -a; source .env.production.local; source /root/.scaleway.env; set +a; node scripts/maintenance/gpu-lease-watchdog.mjs --apply --weekly" >> /var/log/sourcelibrary/gpu-lease-watchdog.log 2>&1
# Hetzner pass of the same watchdog (#5736), hourly: FLAGS (email digest per 6 h + /admin/work) servers with
# no lease-until label, an expired one, or CPU < 5 % over 24 h. Never stops or deletes (a stopped Hetzner
# server still bills). Not guarded on /root/.hcloud.env existing: a missing token must flag, not skip.
# Own lock and state file (hetzner-state.json), so it never clobbers the Scaleway pass. Guarded on the
# rule module so the line is inert until #5736 is on main.
25 * * * * cd /root/sourcelibrary && [ -f scripts/lib/infra-lease.mjs ] && flock -w 600 /tmp/sl-hetzner-lease.lock bash -c "set -a; source .env.production.local; [ -f /root/.hcloud.env ] && source /root/.hcloud.env; set +a; node scripts/maintenance/gpu-lease-watchdog.mjs --hetzner --apply" >> /var/log/sourcelibrary/hetzner-lease-watchdog.log 2>&1
*/30 * * * * bash /root/sourcelibrary/scripts/workers/syriac-kraken-relaunch.sh >> /root/syriac-kraken/relaunch.log 2>&1 # syriac-kraken-4883 (remove when the lane is done)
30 5 * * * cd /root/sourcelibrary && flock -n /tmp/sl-subject-index.lock bash -c "set -a; source .env.production.local; set +a; node scripts/maintenance/build-gallery-subject-index.mjs" >> /var/log/sourcelibrary/subject-index.log 2>&1
# provenance coverage audit (#4613): every page written in the window carries its engine block + content_hash
40 7 * * * cd /root/sourcelibrary && flock -n /tmp/sl-provenance.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/provenance-coverage.mjs --days=2" >> /var/log/sourcelibrary/provenance-coverage.log 2>&1
# pipeline-hold drift audit (committed in crontab.production since #4919 but never installed; installed 2026-09-28)
55 7 * * * cd /root/sourcelibrary && [ -f scripts/audit/pipeline-hold-drift.mjs ] && flock -n /tmp/sl-hold-drift.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/pipeline-hold-drift.mjs" >> /var/log/sourcelibrary/pipeline-hold.log 2>&1
# pipeline_next daily audit + flow snapshot (#5478): recompute nextStep() over every book with pages_count > 0,
# compare with the stored books.pipeline_next and pipeline_auto.status, write ops_reports pipeline-next-<day>
# (type pipeline_next_daily, read by /admin/pipeline). Runs after the 06:00 sync-worker stamp pass. Read-only on
# books/pages; on FAIL one deduped GitHub issue. Exit 1 = FAIL, 2 = could not measure. ~35 s, no model call.
45 6 * * * cd /root/sourcelibrary && [ -f scripts/audit/pipeline-next-step-audit.mjs ] && flock -n /tmp/sl-pipeline-next-audit.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/pipeline-next-step-audit.mjs --apply" >> /var/log/sourcelibrary/pipeline-next-audit.log 2>&1
# mark-stale-translations.mjs --apply (#4927): installed 2026-09-30 (was absent 2026-09-19..30 despite the template)
45 4 * * 0 cd /root/sourcelibrary && flock -n /tmp/sl-clip-index.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/clip-index-integrity.mjs" >> /var/log/sourcelibrary/clip-index-integrity.log 2>&1
# page-vector-truth weekly (#6175): is each stored page vector the Gemini embedding of its page's text? 200 seeded
# live translated books x 3 rows: model-free checks (e5 signature, shape, wrong book, removed translation still served,
# AI summary in the snippet, duplicates) + one realtime embed per row (~$0.06/run) + a --plant positive control
# (exit 2 unless every planted defect is caught). Exit 1 files/updates "Page vector truth: " (label search);
# a clean run closes it. Exit 2 never files. Guarded by [ -f ] until the script is on main.
15 5 * * 0 cd /root/sourcelibrary && [ -f scripts/audit/page-vector-truth.mjs ] && flock -n /tmp/sl-page-vector-truth.lock bash -c "set -a; source .env.production.local; set +a; node scripts/audit/page-vector-truth.mjs --books 200 --seed \$(date +\%G\%V) --plant --dup-probe 50 --file-issue --json /var/log/sourcelibrary/page-vector-truth-last.json" >> /var/log/sourcelibrary/page-vector-truth.log 2>&1
# installed 2026-09-30 per DECIDED (#4927 marker; read by the paid translate lanes)
30 7 * * * cd /root/sourcelibrary && [ -f scripts/maintenance/mark-stale-translations.mjs ] && flock -n /tmp/sl-mark-stale-tr.lock bash -c "set -a; source .env.production.local; set +a; node scripts/maintenance/mark-stale-translations.mjs --apply --since-hours=26" >> /var/log/sourcelibrary/mark-stale-translations.log 2>&1
# Monthly translation corpus audit, stage 1 = the draw (#5301, runbook scripts/eval/translation-corpus-audit/MONTHLY.md).
# No model call, no spend; pushes branch eval/tca-<YYYY-MM>. Stage 2 (the judge) is a claude.ai routine on the 2nd.
30 4 1 * * [ -f /root/sourcelibrary/scripts/eval/translation-corpus-audit/monthly-draw.sh ] && flock -n /tmp/sl-tca-monthly.lock bash /root/sourcelibrary/scripts/eval/translation-corpus-audit/monthly-draw.sh >> /var/log/sourcelibrary/tca-monthly.log 2>&1
# Chained Batch translation lane (#4681): every 5 min one tick collects finished rounds and submits
# the next ones in shared Batch jobs; hourly, up to 40 gap-fill books are enrolled (at most 60 open runs).
# Every round asks the dial / scope envelopes at submit (a queue is stored spend). Both lines share one
# lock, so a manual --loop run under `flock /tmp/sl-translate-chained.lock` pauses them.
*/5 * * * * cd /root/sourcelibrary && [ -f scripts/lib/translate-batch-chained.mjs ] && flock -n /tmp/sl-translate-chained.lock bash -c "set -a; source .env.production.local; set +a; node scripts/workers/translate-batch-worker.mjs --chained --tick" >> /var/log/sourcelibrary/translate-batch-chained.log 2>&1
23 * * * * cd /root/sourcelibrary && [ -f scripts/lib/translate-batch-chained.mjs ] && flock -w 240 /tmp/sl-translate-chained.lock bash -c "set -a; source .env.production.local; set +a; node scripts/workers/translate-batch-worker.mjs --chained --enrol-auto --limit=40 --max-open=60" >> /var/log/sourcelibrary/translate-batch-chained.log 2>&1
# Batch API enrichment backfill (#2141): summary + index + chapters for live translated books that are
# already PAST the realtime enrich lane's statuses (5,631 such books on 2026-10-07 — translation outran
# enrichment because the scheduler's enrich-worker only selects translate_complete). Every 15 min a
# collect-only tick (--limit=0) writes finished rounds and submits each book's next round; every hour up to
# 200 new books are admitted, all three rounds priced up front, capped at $10 per admission (Derek sped this
# up on the live crontab 2026-10-07; was every 6 h, 40 books, $2.50). The dial / envelopes still gate it.
# Submission asks the dial / scope envelopes under label 'enrich-worker-batch'; collecting is free.
# Both lines share one lock. Guarded on the lane module so the lines are inert until #6129 is on main.
*/15 * * * * cd /root/sourcelibrary && [ -f scripts/workers/lib/enrich-batch-lane.mjs ] && flock -n /tmp/sl-enrich-batch.lock bash -c "set -a; source .env.production.local; set +a; node scripts/workers/enrich-worker.mjs --batch --limit=0" >> /var/log/sourcelibrary/enrich-batch.log 2>&1
40 * * * * cd /root/sourcelibrary && [ -f scripts/workers/lib/enrich-batch-lane.mjs ] && flock -w 600 /tmp/sl-enrich-batch.lock bash -c "set -a; source .env.production.local; set +a; node scripts/workers/enrich-worker.mjs --batch --limit=200 --max-usd=10" >> /var/log/sourcelibrary/enrich-batch.log 2>&1
# #5705 work board (/admin/work): push this box's claude-job state + the GitHub side to ops_reports every 10 min. Script lands on main with the #5705 PR; until then this logs 'Cannot find module'.
*/10 * * * * flock -n /tmp/sl-work-board.lock bash -c 'cd /root/sourcelibrary && node --env-file=.env.production.local scripts/maintenance/work-board-push.mjs --box hetzner; node --env-file=.env.production.local scripts/maintenance/work-board-push.mjs --github' >> /var/log/sourcelibrary/work-board.log 2>&1
