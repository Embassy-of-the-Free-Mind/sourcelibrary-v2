{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/queue/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/upload/from-s3/route.ts": {
      "maxDuration": 180,
      "memory": 1024
    }
  },
  "queues": [
    {
      "name": "book-batch-ocr",
      "concurrency": 5,
      "timeout": 300,
      "maxRetries": 3
    },
    {
      "name": "batch-monitor",
      "concurrency": 10,
      "timeout": 300,
      "maxRetries": 5
    },
    {
      "name": "book-batch-translation",
      "concurrency": 3,
      "timeout": 300,
      "maxRetries": 3
    }
  ],
  "crons": [
    {
      "path": "/api/cron/archive-ocr",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/social-post",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/social-reset",
      "schedule": "0 0 * * *"
    }
  ]
}
