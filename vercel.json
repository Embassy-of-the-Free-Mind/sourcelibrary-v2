    },
    {
      "path": "/api/cron/enrich-entities",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/storage-stats",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/dashboard-snapshot",
      "schedule": "20 * * * *"
    }
  ]
