{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/queue/book-batch-ocr/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "book-batch-ocr",
          "consumer": "default",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/queue/batch-monitor/route.ts": {      
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "batch-monitor",
          "consumer": "default",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/queue/book-batch-translation/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "book-batch-translation",
          "consumer": "default",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/queue/test-queue/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "test-queue",
          "consumer": "default",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/upload/from-s3/route.ts": {
      "maxDuration": 180,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/archive-ocr",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/social-post",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/social-reset",
      "schedule": "0 0 * * *"
    }
  ]
}
