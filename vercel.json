{
  "regions": ["fra1"],
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- src/ public/ next.config.ts vercel.json package.json package-lock.json",
  "crons": [
    {
      "path": "/api/cron/warm",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/collection-health",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-bph-sl-book-ids",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/sync-catalog-sl-book-ids",
