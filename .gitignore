# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.secrets.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Catalog data files (too large for git)
data/
!src/app/data/
!src/data/
!public/data/
src/data/*
