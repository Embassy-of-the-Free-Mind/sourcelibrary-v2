!src/data/shwep-linked-bibliographies.ts

# User uploads and test files
public/uploads/
public/test-images/

# Debug scripts
check-books.js

# Temp files
tmp/
tmp_*
_tmp-*
scripts/_tmp-*
scripts/output/
/check-*.mjs

# Experimental tools
tools/
.env*.local

# MCP config (user-specific paths)
.mcp.json

# MCP server secrets and build
mcp-server/.mcpregistry_*
mcp-server/node_modules/
mcp-server/dist/
logs/*.log
split-review.html
input.json
supabase/.temp/
.wrangler/
