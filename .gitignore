# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/
e2e/perf-results.json

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.secrets.json
# Explicitly un-ignore .env.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Catalog data files (too large for git)
data/
!src/app/data/
!src/data/
!public/data/
src/data/*
!src/data/concept-diffusion.json
!src/data/concept-diffusion-research.json
!src/data/book-constellation.json
!src/data/image-constellation.json
!src/data/marcianus-berthelot-overlay.json
!src/data/jung-bph-alignment-2026-05-22.json
!src/data/carbon-ledger/
!src/data/carbon-ledger/*.json
!src/data/shwep-bibliographies.ts
!src/data/shwep-linked-bibliographies.ts
!src/data/shwep-supplementary-works.ts

# User uploads and test files
public/uploads/
public/test-images/

# Debug scripts
check-books.js

# Temp files
tmp/
tmp_*
_tmp-*
_tmp_*
scripts/_tmp-*
scripts/_tmp_*
scripts/output/
/check-*.mjs

# Generated publication artifacts (EPUBs, covers, extracted plate images, manifests).
# These are large binaries built on demand from the library — never committed.
esoteric-geometries-out/
kdp-out/
**/*.epub
.geo-*.jpg

# Session coordination scratch (its own README says: never commit)
.claude/agent-comms/

# Experimental tools
tools/
.env*.local

# MCP config (user-specific paths)
.mcp.json

# MCP server secrets and build
mcp-server/.mcpregistry_*
mcp-server/node_modules/
mcp-server/dist/
logs/*.log
split-review.html
input.json
supabase/.temp/
.wrangler/
# lamejs bundle — generated by scripts/build-lamejs-bundle.js (npm prebuild)
src/lib/vendor/lamejs-bundle.js

# Per-book undo snapshots from data-repair scripts (#1713/#1721/#1719)
.claude/docs/snapshots/

# Dedup workflow transient state (proposals, review queue)
.claude/docs/dedup-proposals/
.claude/docs/dedup-proposals-applied/
.claude/docs/dedup-proposals-staging/
.claude/docs/dedup-review-queue/
.claude/docs/dedup-review-queue-resolved/

# Operational content is PRIVATE — lives in Embassy-of-the-Free-Mind/sourcelibrary-ops.
# This repo is public (AGPL). Handoffs and business docs must not be committed here.
# (Older technical handoffs already in history stay tracked until a coordinated scrub.)
.claude/handoffs/
.claude/docs/fundraising*
.claude/docs/*outreach*
.claude/docs/*contact*
.claude/docs/*budget*
.claude/docs/*donor*
.claude/docs/*sponsor*
# Local scratch (per-machine, never shared)
.claude/stash-archive/
backups/

# Book ingestion staging (PDFs, page images, metadata waiting to be processed)
incoming/
scripts/eval/ft-tier2-bulk.workflow.js
scripts/eval/ft-tier2-rerun.workflow.js
scripts/eval/ft-recall.workflow.js
scripts/eval/ft-reliability.workflow.js
scripts/eval/ft-groundtruth.workflow.js
scripts/eval/results/ft-gemini-*.json
scripts/eval/results/ft-enum-*.json

# Corpus-scale revision-agreement rows (~110MB of per-pair JSONL, regenerable
# for free from Mongo via scripts/eval/revision-agreement-corpus.mjs).
# The summary JSON + markdown reports beside it ARE committed.
scripts/eval/results/revision-agreement-corpus-*.jsonl

# Per-run import ledgers (progress state, not source)
scripts/import/*-ledger.jsonl
