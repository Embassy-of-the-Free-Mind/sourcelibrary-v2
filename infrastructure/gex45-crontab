*/10 * * * * f=/root/sourcelibrary/scripts/catalog-coverage/archive-lanes-revive.sh; [ -x $f ] && ARCHIVE_LANES_BOX=gex45 $f >> /var/log/sourcelibrary/archive-lanes-revive.log 2>&1  # #5448

