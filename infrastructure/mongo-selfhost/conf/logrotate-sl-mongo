# /etc/logrotate.d/sl-mongo (#346)
/var/log/mongodb/mongod.log {
  daily
  rotate 14
  compress
  delaycompress
  missingok
  notifempty
  postrotate
    /bin/kill -USR1 $(pidof mongod) 2>/dev/null || true
  endscript
}
/var/log/sl-follower/*.log /var/log/mongot/*.log {
  daily
  rotate 14
  compress
  missingok
  notifempty
  copytruncate
}
