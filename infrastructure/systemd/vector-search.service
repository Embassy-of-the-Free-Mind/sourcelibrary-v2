# Page-vector service for semantic page search (#6821). Installed on l7a (earthai-l7a, 167.233.32.250)
# at /etc/systemd/system/vector-search.service:
#
#   cp infrastructure/systemd/vector-search.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable vector-search      # bootstrap.sh starts it once the index exists
#
# Code: /data/vector-search/app (a copy of scripts/workers/vector-search with its own node_modules —
# `npm install` there, never in the repo; see that directory's README.md). Index: /data/vector-search/index.
# Secrets: /etc/vector-search.env, mode 600, never in the repo:
#   VECTOR_SEARCH_TOKEN=<openssl rand -hex 32>
#   VECTOR_SEARCH_PORT=3458          Bearer token, on VECTOR_SEARCH_HOST (below: loopback). Reached from outside
#                                    only as https://vectors.sourcelibrary.org through Caddy
#                                    (infrastructure/caddy/Caddyfile.l7a, #6843); ufw allows 80/443, not 3458.
#   VECTOR_SEARCH_LOCAL_PORT=3459    127.0.0.1 only, no auth, /admin for sync-delta.mjs
#
# Memory: ~9 GB resident (index + row metadata), in its own search.slice (infrastructure/systemd/
# l7a-search.slice: MemoryMin 9G, no MemoryHigh), NOT sourcelibrary.slice: on 2026-10-17 two jobs pushed
# that slice over its MemoryHigh and the kernel throttled this service with them, so every shadow call
# timed out (#6821). Startup reads the index into RAM (`load`, not `view`) and takes a minute or two;
# /health answers once it is ready.
[Unit]
Description=Source Library page-vector service (in-RAM HNSW over page_translations, #6821)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=search.slice
WorkingDirectory=/data/vector-search/app
EnvironmentFile=/etc/vector-search.env
Environment=VECTOR_SEARCH_ROOT=/data/vector-search
Environment=VECTOR_SEARCH_HOST=127.0.0.1
ExecStart=/usr/bin/node --no-warnings --max-old-space-size=3072 /data/vector-search/app/server.mjs
Restart=always
RestartSec=30
StandardOutput=append:/data/vector-search/logs/server.log
StandardError=append:/data/vector-search/logs/server.log

[Install]
WantedBy=multi-user.target
